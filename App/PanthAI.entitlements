<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets MLX hold larger models before iPadOS jetsam kills the app. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<!-- Optional iCloud sync (Settings > iCloud): chats, agents, hosts and settings in the user's own private iCloud. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.dosanjhlabs.panthai</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<!-- Lets iCloud wake the app to deliver changes from your other devices. Xcode switches this to production when archiving. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
